# Disable script execution in uploads directory
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|phps|pl|py|cgi|sh|exe|bat|cmd|com|asp|aspx|jsp|shtml|bin)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Turn off PHP engine if mod_php is active
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Prevent directory indexing
Options -Indexes -ExecCGI
